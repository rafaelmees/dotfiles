#!/usr/bin/env bash
#
# Installs `fleet` — the git worktree manager for running several agents in
# parallel (see the `fleet` script header for the full picture).
# - Safe to re-run: each step skips work that's already done.
#
# What it does:
#   - symlinks `fleet` into ~/.local/bin (on PATH via zsh/.zshrc)
#   - symlinks the shell completion into ~/.config/fleet/completion.bash
#     (zsh/.zshrc sources it when present)
#   - asks where to keep the fleet home (default ~/Development/fleet) and saves
#     the choice to ~/.config/fleet/home so `fleet` uses it from then on
#   - seeds <fleet home>/repositories.json from the example, if missing
#
# The location is chosen from (first wins): --home <dir>, $FLEET_HOME, an
# interactive prompt, then the default. Non-interactive runs take the default.
#
# Run standalone:  ./fleet/install [--home <dir>]
# Via installer:   ./install --install-fleet
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DEFAULT_HOME="$HOME/Development/fleet"
HOME_FILE="$HOME/.config/fleet/home"
HOME_ARG=""

while [ $# -gt 0 ]; do
  case "$1" in
    --home) HOME_ARG="${2:-}"; shift ;;
    *) printf '\033[1;33m  !\033[0m unknown option: %s\n' "$1" ;;
  esac
  shift
done

info()  { printf "\033[1;37m==>\033[0m %s\n" "$1"; }
ok()    { printf "\033[1;32m  ✓\033[0m %s\n" "$1"; }
warn()  { printf "\033[1;33m  !\033[0m %s\n" "$1"; }

# Resolves the fleet home: --home > $FLEET_HOME > saved > interactive prompt > default.
resolve_fleet_home() {
  local reply default="$DEFAULT_HOME"
  [ -f "$HOME_FILE" ] && default="$(cat "$HOME_FILE" 2>/dev/null || true)"
  [ -n "$default" ] || default="$DEFAULT_HOME"

  if [ -n "$HOME_ARG" ]; then
    FLEET_HOME="$HOME_ARG"
  elif [ -n "${FLEET_HOME:-}" ]; then
    :
  elif [ -t 0 ]; then
    printf "\033[1;37m==>\033[0m Where should fleet keep its repos? [%s] " "$default" >&2
    read -r reply || reply=""
    FLEET_HOME="${reply:-$default}"
  else
    FLEET_HOME="$default"
  fi

  FLEET_HOME="${FLEET_HOME/#\~/$HOME}"   # expand a leading ~
}

resolve_fleet_home

# Creates a symlink $2 -> $HERE/$1, backing up anything already at $2.
# (Mirrors install's link(); duplicated so this script runs standalone.)
link() {
  local src="$HERE/$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    ok "$dest (already linked)"
    return
  fi
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    mkdir -p "$BACKUP_DIR"
    mv "$dest" "$BACKUP_DIR/"
    warn "backup: $dest -> $BACKUP_DIR/"
  fi
  ln -s "$src" "$dest"
  ok "$dest -> $src"
}

info "Installing fleet..."
link "fleet"                  "$HOME/.local/bin/fleet"
link "fleet-completion.bash"  "$HOME/.config/fleet/completion.bash"

info "Creating fleet home..."
mkdir -p "$FLEET_HOME"
mkdir -p "$(dirname "$HOME_FILE")"
printf '%s\n' "$FLEET_HOME" > "$HOME_FILE"
ok "$FLEET_HOME (saved to $HOME_FILE)"

if [ -f "$FLEET_HOME/repositories.json" ]; then
  ok "repositories.json already exists"
else
  cp "$HERE/repositories.example.json" "$FLEET_HOME/repositories.json"
  ok "seeded repositories.json (edit it to add your repos)"
fi

if ! command -v jq >/dev/null 2>&1; then
  warn "jq not found — fleet needs it (brew install jq)."
fi

info "Done!"
info "Open a new shell (exec zsh) so 'fleet' and its completion load."
info "Then edit $FLEET_HOME/repositories.json and run: fleet repos"
[ -d "$BACKUP_DIR" ] && warn "Old files saved in: $BACKUP_DIR"
