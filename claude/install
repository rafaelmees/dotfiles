#!/usr/bin/env bash
#
# Installs Claude Code (the terminal CLI) plus a few token-saving plugins/skills,
# and links the versioned Claude config (CLAUDE.md, settings.json, status line).
# - Safe to re-run: each step skips work that's already done.
# - Cross-platform: macOS and Linux.
#
# Installs:
#   - Claude Code   official terminal CLI (claude.ai/install.sh)
#   - jq            JSON parser used by the status line
#   - rtk           compresses noisy command output before it reaches the model
#   - caveman       terse "caveman-speak" replies to cut output tokens
#   - ponytail      "lazy senior dev" skill — pushes minimal, YAGNI-friendly code
#
# Links (symlinks, so editing the repo file updates the live config):
#   claude/CLAUDE.md     -> ~/.claude/CLAUDE.md      personal instructions (all projects)
#   claude/settings.json -> ~/.claude/settings.json  vim mode, permissions, status line
#   claude/statusline.sh -> ~/.claude/statusline.sh  grayscale status line
#
# Optional components (the Claude CLI and the linked config are always set up):
#   jq  rtk  caveman  ponytail
# Pick what to install with (component names as above):
#   --only <a,b>   install only these components
#   --skip <a,b>   install everything except these
#
# Run standalone:  ./claude/install [--only ...] [--skip ...]
# Via installer:   ./install --install-claude
#
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

info()  { printf "\033[1;37m==>\033[0m %s\n" "$1"; }
ok()    { printf "\033[1;32m  ✓\033[0m %s\n" "$1"; }
warn()  { printf "\033[1;33m  !\033[0m %s\n" "$1"; }

# --- component selection (--only / --skip) ---------------------------------
KNOWN_COMPONENTS="rtk caveman ponytail"
SKIP="" ONLY=""
add_list() { local t; for t in ${2//,/ }; do [ -n "$t" ] && eval "$1=\"\${$1:+\$$1,}\$t\""; done; }

while [ $# -gt 0 ]; do
  case "$1" in
    --only) add_list ONLY "${2:-}"; shift ;;
    --skip) add_list SKIP "${2:-}"; shift ;;
    *) warn "unknown option: $1" ;;
  esac
  shift
done

for _t in ${SKIP//,/ } ${ONLY//,/ }; do
  case " $KNOWN_COMPONENTS " in *" $_t "*) ;; *) warn "unknown component: $_t (known: $KNOWN_COMPONENTS)" ;; esac
done
unset _t

# want <component> — true unless skipped, or unless --only is set and excludes it
want() {
  case ",$SKIP," in *",$1,"*) return 1 ;; esac
  if [ -n "$ONLY" ]; then
    case ",$ONLY," in *",$1,"*) return 0 ;; *) return 1 ;; esac
  fi
  return 0
}

# Creates a symlink $2 -> $DOTFILES/$1, backing up anything already at $2.
# (Mirrors install's link(); duplicated so this script runs standalone.)
link() {
  local src="$DOTFILES/$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    ok "$dest (already linked)"
    return
  fi
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    mkdir -p "$BACKUP_DIR"
    mv "$dest" "$BACKUP_DIR/"
    warn "backup: $dest -> $BACKUP_DIR/"
  fi
  ln -s "$src" "$dest"
  ok "$dest -> $src"
}

# Both the Claude installer and rtk's fallback drop binaries in ~/.local/bin,
# which usually isn't on PATH in a non-login shell — make sure it is here so the
# steps below can find `claude`/`rtk` right after installing them.
export PATH="$HOME/.local/bin:$PATH"

# --- Claude Code CLI --------------------------------------------------------
if command -v claude >/dev/null 2>&1; then
  ok "claude already installed ($(claude --version 2>/dev/null || echo present))"
else
  info "Installing Claude Code..."
  curl -fsSL https://claude.ai/install.sh | bash
  hash -r
  command -v claude >/dev/null 2>&1 \
    && ok "claude installed" \
    || warn "claude installed but not on PATH — open a new shell and re-run."
fi

# --- Link the versioned Claude config --------------------------------------
# Done BEFORE rtk/caveman/ponytail: those tools register hooks inside
# ~/.claude/settings.json, so linking first lets them merge into the versioned
# file instead of us clobbering their hooks (or theirs clobbering our config).
info "Linking Claude config..."
link "claude/CLAUDE.md"     "$HOME/.claude/CLAUDE.md"
link "claude/settings.json" "$HOME/.claude/settings.json"
link "claude/statusline.sh" "$HOME/.claude/statusline.sh"

# --- jq (used by the status line) ------------------------------------------
if command -v jq >/dev/null 2>&1; then
  ok "jq already installed"
elif command -v brew >/dev/null 2>&1; then
  info "Installing jq..."
  brew install jq
else
  warn "jq not found and no brew — the status line shows '?' until you install jq."
fi

# --- rtk (Rust Token Killer) ------------------------------------------------
# Compresses common dev-command output (git, tests, ls, grep, ...) via a
# PreToolUse hook, so the raw terminal noise never reaches the model.
if ! want rtk; then
  info "Skipping rtk (--skip/--only)."
else
  if command -v rtk >/dev/null 2>&1; then
    ok "rtk already installed"
  else
    info "Installing rtk..."
    if command -v brew >/dev/null 2>&1; then
      brew install rtk
    else
      # No Homebrew (e.g. a bare Linux box) — use the official install script.
      curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh
      hash -r
    fi
  fi

  if command -v rtk >/dev/null 2>&1; then
    info "Configuring rtk (rtk init -g)..."
    rtk init -g && ok "rtk hook installed globally"
  else
    warn "rtk not on PATH — skipped 'rtk init -g'. Re-run after opening a new shell."
  fi
fi

# --- caveman ----------------------------------------------------------------
# The installer auto-detects installed agents and wires them up itself; no
# manual per-agent config needed. Safe to re-run.
if ! want caveman; then
  info "Skipping caveman (--skip/--only)."
else
  info "Installing caveman..."
  curl -fsSL https://raw.githubusercontent.com/JuliusBrussee/caveman/main/install.sh | bash \
    && ok "caveman installed" \
    || warn "caveman install failed — check the output above."
fi

# --- ponytail ---------------------------------------------------------------
# A Claude Code plugin (not a curl script): add its marketplace, then install.
# Both commands are idempotent-ish; guard so a re-add/re-install can't abort us.
if ! want ponytail; then
  info "Skipping ponytail (--skip/--only)."
elif command -v claude >/dev/null 2>&1; then
  info "Installing ponytail (Claude Code plugin)..."
  claude plugin marketplace add DietrichGebert/ponytail \
    || warn "ponytail marketplace add reported an issue (already added?)."
  claude plugin install ponytail@ponytail \
    && ok "ponytail installed" \
    || warn "ponytail install reported an issue (already installed?)."
else
  warn "claude not available — skipped ponytail. Install Claude Code first, then re-run."
fi

info "Done!"
info "Restart Claude Code so the new config, plugins and hooks load."
[ -d "$BACKUP_DIR" ] && warn "Old files saved in: $BACKUP_DIR"
