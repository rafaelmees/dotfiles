font-family = JetBrainsMono Nerd Font
font-size = 14

background = #181818
foreground = #d0d0d0

cursor-color = #ffffff
cursor-style = block

selection-background = #333333

window-padding-x = 0
window-padding-y = 0

background-opacity = 0.75
background-blur = 20

# Free up Ctrl+Tab / Ctrl+Shift+Tab for the app (Neovim switches tabs with them).
# Ghostty's own tabs stay on Cmd+Shift+[ / Cmd+Shift+] and Cmd+1…9.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
